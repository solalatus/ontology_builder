# Template for the repo-root .env (gitignored; never commit the real one).
# Read by the live tests, evals and experiment scripts (tests/lib/llmProvider.mjs)
# and the Python tools (ontology_translation/tools/env.py) alike, so changing
# the provider here moves all of them (issue #183). Fill in one provider.

# openai | azure | bedrock. Optional: without it, Azure if AZURE_OPENAI_ENDPOINT
# is set, else Bedrock if AWS_BEARER_TOKEN_BEDROCK is, else OpenAI.
LLM_PROVIDER=
# Optional: one model for every role (a deployment name on Azure, a Bedrock
# model id such as openai.gpt-6.1-sol on Bedrock).
LLM_MODEL=

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock (a Bedrock API key; requests go to bedrock-mantle)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_ENDPOINT=
BEDROCK_MODEL=
