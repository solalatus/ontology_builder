    "rawResponses": {
      "classes": "1: NO MATCH -- A setpoint is not an air quality sensor.\n2: MATCH 1 -- It specifies a desired temperature.\n3: NO MATCH -- A setpoint is not a condensing unit.\n4: NO MATCH -- A setpoint is not a heat exchanger.\n5: NO MATCH -- A setpoint is not a humidifier.\n6: NO MATCH -- A setpoint is not an isolation valve.\n7: NO MATCH -- A setpoint is not a dry cooler.",
      "relationships": "1: MATCH 6 -- An AHU having a fan is the same part relationship.\n2: MATCH 7 -- An AHU having a filter is the same part relationship.\n3: MATCH 8 -- An AHU having a damper is the same part relationship.\n4: MATCH 10 -- An AHU having a cooling valve is the same part relationship.\n5: MATCH 9 -- An AHU having a heating valve is the same part relationship.\n6: MATCH 11 -- An AHU having an economizer is the same part relationship.\n7: MATCH 15 -- Both link the AHU to its air temperature sensor point.\n8: MATCH 16 -- Both link the AHU to its air temperature setpoint.\n9: MATCH 17 -- Both link the AHU to its cooling temperature setpoint.\n10: MATCH 18 -- Both link the AHU to its heating temperature setpoint.\n11: MATCH 19 -- Both link the AHU to its temperature deadband setpoint.\n12: MATCH 5 -- The thermostat's temperature sensor input is its sensor point.\n13: MATCH 12 -- Both link the zone to its occupancy sensor point.\n14: MATCH 22 -- Installation in a building specifies the sensor's location.\n15: MATCH 1 -- A building containing a floor is the same part relationship.\n16: MATCH 3 -- A floor containing a space is the same part relationship.\n17: MATCH 2 -- A building containing a zone is the same part relationship.\n18: MATCH 20 -- Both link the AHU to its outside air CO2 sensor point.\n19: MATCH 21 -- Both link the AHU to its return air CO2 sensor point.",
      "properties": "1: MATCH \"reading\" -- Both name the measured temperature.\n2: NO MATCH -- A reading is not the sensor’s status.\n3: MATCH \"reading\" -- Both name the measured air temperature.\n4: MATCH \"reading\" -- Both name the measured CO2 level.\n5: MATCH \"reading\" -- Both name the measured outside-air CO2 level.\n6: MATCH \"reading\" -- Both name the measured return-air CO2 level.\n7: NO MATCH -- “Occupied” specifies an occupancy state; “reading” does not.\n8: MATCH \"condition\" -- Both describe the filter’s current state.\n9: MATCH \"reading\" -- Both name the measured CO2 differential.\n10: MATCH \"reading\" -- Both name the measured water temperature.",
      "valueFidelity": "1: 100 -- Identical values.\n2: 100 -- Identical values.\n3: 100 -- Identical values.\n4: 100 -- Identical values.\n5: 100 -- Identical values.\n6: 100 -- Identical values.\n7: 100 -- Identical values.\n8: 100 -- Identical values.\n9: 100 -- Identical values.\n10: 100 -- Identical values.\n11: 100 -- Identical values.\n12: 100 -- Identical values."
